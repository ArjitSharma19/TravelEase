# Copy this file to '.env' and fill in your actual API key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
PORT=3000
MONGODB_URI=mongodb://localhost:27017/travelease
JWT_SECRET=your_jwt_secret_here
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here
REST_COUNTRIES_API_KEY=YOUR_REST_COUNTRIES_API_KEY
UNSPLASH_API_KEY=YOUR_UNSPLASH_API_KEY

# Gmail SMTP credentials for sending password reset emails
EMAIL_USER=your_gmail_username@gmail.com
EMAIL_PASS=your_gmail_app_password
